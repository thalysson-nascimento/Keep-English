# Runtime URL; use the pooled connection string when your provider supplies one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct URL for Prisma CLI commands and migrations. If your provider does not
# supply separate pooled and direct URLs, use the same connection string above.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the same value between deployments; never commit the generated secret.
BETTER_AUTH_SECRET=""

# Use your canonical production URL in Vercel.
BETTER_AUTH_URL="http://localhost:3000"
# Optional closed-beta convenience. This value is sent to the login page browser.
# Never use a real or reused password, and remove it before public release.
LOGIN_DEFAULT_PASSWORD=""
