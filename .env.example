# Direct URL used by Prisma CLI migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Prisma Postgres supplies this pooled URL for application requests. If your
# provider has no pooled URL, the app falls back to DATABASE_URL.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the same value between deployments; never commit the generated secret.
BETTER_AUTH_SECRET=""

# Use your canonical production URL in Vercel.
BETTER_AUTH_URL="http://localhost:3000"
# Optional closed-beta convenience. This value is sent to the login page browser.
# Never use a real or reused password, and remove it before public release.
LOGIN_DEFAULT_PASSWORD=""
